@using DevilDaggersInfo.Web.Client.Utils
<div>
	@if (UserUtils.TryGetCountry(CountryCode, out Country country))
	{
		<Tooltip Position=TooltipPosition.Right Text="@country.Name"><img class="cursor-pointer inline-block" src="@country.FlagPath" /></Tooltip>
	}
</div>

@code
{
	[Parameter] public string? CountryCode { get; set; }
}
