@page "/admin/file-system"
@inherits BaseAdminPage
@using DevilDaggersInfo.Web.Client.Components
@using DevilDaggersInfo.Web.Client.Components.Admin
@using DevilDaggersInfo.Web.Client.Utils
@using DevilDaggersInfo.Web.Core.Claims
@using DevilDaggersInfo.Web.ApiSpec.Admin.FileSystem

<AdminAuthorizer Base="this" RequiredRole="@Roles.Admin">
	<Heading Title="Admin - File System" />

	@if (_fileSystemInfo == null)
	{
		<Loading />
	}
	else
	{
		<a class="btn btn-green cursor-pointer block w-40 mb-2 mx-1" @onclick="async () => await FetchAsync()">Refresh</a>

		<div>@_fileSystemInfo.TotalSize.ToString("N0") bytes / @_fileSystemInfo.AllowedSizeByModArchiveProcessor.ToString("N0") bytes</div>

		<div class="grid gap-x-2 grid-cols-5">
			<span class="font-bold col-span-2">Name</span>
			<span class="font-bold text-right">Size</span>
			<span class="font-bold text-right">Size in bytes</span>
			<span class="font-bold text-right">Count</span>
			@foreach (GetFileSystemEntry fse in _fileSystemInfo.Entries)
			{
				<span class="col-span-2">@fse.Name</span>
				<span class="text-right">@FileSizeUtils.Format(fse.Size)</span>
				<span class="text-right">@fse.Size.ToString("N0")</span>
				<span class="text-right">@fse.Count.ToString("N0")</span>
			}
		</div>
	}
</AdminAuthorizer>

@code
{
	private GetFileSystemInfo? _fileSystemInfo;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		await FetchAsync();
	}

	private async Task FetchAsync()
	{
		try
		{
			_fileSystemInfo = null;
			_fileSystemInfo = await Http.GetFileSystemInfo();
			StateHasChanged();
		}
		catch (AccessTokenNotAvailableException exception)
		{
			exception.Redirect();
		}
	}
}
