<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately references only the domain projects. Referencing the server project would pull in the Blazor client,
         whose build runs the Tailwind CLI. Anything that needs the web layer belongs in DevilDaggersInfo.Web.Server.IntegrationTest. -->
    <ProjectReference Include="..\..\DevilDaggersInfo.Web.Server.Domain\DevilDaggersInfo.Web.Server.Domain.csproj" />
    <ProjectReference Include="..\..\DevilDaggersInfo.Web.Server.Domain.Main\DevilDaggersInfo.Web.Server.Domain.Main.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="..\Tests.globalconfig" />
  </ItemGroup>

</Project>
